# Core
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://szombade4589v_db_user:aq3iDtbQ7zMZ8z1F@portfolio.hj1jne3.mongodb.net/portfolio?appName=portfolio

# Admin bootstrap (created automatically if Admin collection is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_now

# JWT
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated). Include both Netlify public + admin dashboard domains.
# Example:
# CORS_ORIGINS=https://your-portfolio.netlify.app,https://your-admin.netlify.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio Contact <no-reply@example.com>"

# Where to link users for password reset.
# If contains {token}, it will be replaced.
# Otherwise token will be appended as ?token=...
ADMIN_RESET_URL=https://your-admin.netlify.app/reset-password?token={token}
